# GEMINI_API_KEY: Required for CineBot Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for GPS & Theatre Map.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# TMDB_API_KEY: Optional TMDB v3 API key for live theatrical movie metadata.
TMDB_API_KEY=""

# CINEMA_PROVIDER_API_KEY: Optional authorized cinema/showtime partner API key.
CINEMA_PROVIDER_API_KEY=""

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay test mode credentials for INR payments.
RAZORPAY_KEY_ID="rzp_test_cinenexus_demo"
RAZORPAY_KEY_SECRET=""
